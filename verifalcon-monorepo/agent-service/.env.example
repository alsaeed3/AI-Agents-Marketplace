# ================================================================================
# Environment Variables for Agent Service
# ================================================================================
# Copy this file to .env and fill in your values
# 
# ⚠️  WARNING: NEVER commit your .env file to version control!
#     The .gitignore should already exclude it.
# ================================================================================

# ================================================================================
# REQUIRED VARIABLES (Service will not start without these)
# ================================================================================

# Your wallet private key (DO NOT share or commit this!)
# Get from MetaMask: Account Details > Export Private Key
# Example: 0x1234567890abcdef...
PRIVATE_KEY=your_private_key_here

# BSC Testnet RPC URL
# You can use the default public endpoint or get a dedicated one from:
# - Ankr: https://ankr.com
# - NodeReal: https://nodereal.io
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Google Gemini API Key for AI capabilities
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ================================================================================
# OPTIONAL VARIABLES (Some features may not work without these)
# ================================================================================

# Deployed contract addresses (from deploy-marketplace.js output)
# Run the deployment script and copy the addresses here
AGENT_REGISTRY_ADDRESS=
PAYMENT_ROUTER_ADDRESS=

# Agent ID (after registering your agent)
# This is used for reputation updates
AGENT_ID=

# ================================================================================
# LEGACY VARIABLES (From original VeriFalcon - keep for reference)
# ================================================================================

# Original VeriBot contract address (now in contracts/archive/)
VERIBOT_ADDRESS=

# ================================================================================
# DEVELOPMENT VARIABLES (Optional)
# ================================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable debug mode for verbose logging
DEBUG=false
